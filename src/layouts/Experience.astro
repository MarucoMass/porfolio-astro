---
import SectionContainer from "../components/SectionContainer.astro";
import ExperienceList from "../components/ExperienceList.astro";
import Heading from "../components/Heading.astro";
const { jobs, education, headings } = Astro.props;
---

<SectionContainer id={headings[0].toLowerCase()}  class="section">
  <Heading>{headings[0]}</Heading>
  <ExperienceList jobs={jobs} education={education} headings={headings}/>
</SectionContainer>
