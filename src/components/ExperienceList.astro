---
import ExperienceItem from "./ExperienceItem.astro";
// import { JOBS } from "./data/jobs.js";
// import { EDUCATIVE } from "./data/educative.js";

const { class: className, jobs, education, headings } = Astro.props;
---

<div class={`mb-6 flex flex-col gap-y-7 ${className}`}>
  <h2 class="text-2xl lg:text-4xl font-bold dark:text-white">{headings[1]}</h2>
  {jobs.map((job: any) => <ExperienceItem {...job} />)}

  <h2 class="text-2xl lg:text-4xl font-bold mt-10 dark:text-white">
    {headings[2]}
  </h2>
  {education.map((education: any) => <ExperienceItem {...education} />)}
</div>
