---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Aside from "../layouts/Aside.astro";
import Experience from "../layouts/Experience.astro";
import Projects from "../layouts/Projects.astro";
import About from "../layouts/About.astro";
import data from "../data/data.json";
import ButtonTop from "../components/ButtonTop.astro";


const lang = "en"; 
const content = data[lang];
const { header, hero, jobs, education, headings, projects, about, aside } = content;
---

<Layout
  title="Mario Mass - FullStack Developer"
  description="FullStack Developer"
>
  <main
    class="grid grid-cols-1 gap-y-16 lg:grid-cols-2 md:px-12 px-5 max-w-[1600px] mx-auto relative"
  >
    <Aside asideData={aside}/>

    <SectionContainer class="gap-y-28 mx-auto pb-20" id="layoutContainer">
      <Header headerData={header}/>

      <h1 class="text-3xl md:text-6xl font-extrabold text-black dark:text-white/90 text-balance">
        <span class="text-heading">{hero.substring(0, 8)}</span> {hero.substring(8)}
      </h1>

      <Experience jobs={jobs} education={education} headings={headings}/>
      <Projects projects={projects} headings={headings[3]}/>
      <About aboutData={about} headings={headings}/>
    </SectionContainer>
    
    <footer class="absolute bottom-0 w-full py-2">
      <h4 class="dark:text-white text-center">
        Mario Mass - <span id="year"></span>
      </h4>
    </footer>
  </main>
  
 <ButtonTop />

</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const yearElement = document.getElementById("year");
    if (yearElement) {
      yearElement.innerText = new Date().getFullYear().toString();
    }

    const lang = localStorage.getItem("lang") || "es"; 
    localStorage.setItem("lang", lang);

  });
</script>
